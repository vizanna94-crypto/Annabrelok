<script>
document.addEventListener("DOMContentLoaded", () => {
  // Клик для переворота карты на мобильных
  const card = document.getElementById("tarotCard");
  if(card) {
    card.addEventListener("click", () => {
      card.classList.toggle("flipped");
    });
  }

  // Генерация звездного фона
  function makeStars(id, count, className, sizeMin, sizeMax, opacityMin, opacityMax, durationMin, durationMax, driftDuration) {
    const layer = document.getElementById(id);
    if (!layer) return;
    const frag = document.createDocumentFragment();

    for (let i = 0; i < count; i++) {
      const star = document.createElement("span");
      star.className = "star " + className;
      const size = sizeMin + Math.random() * (sizeMax - sizeMin);
      star.style.left = Math.random() * 100 + "%";
      star.style.top = Math.random() * 100 + "%";
      star.style.width = size + "px";
      star.style.height = size + "px";
      star.style.opacity = opacityMin + Math.random() * (opacityMax - opacityMin);
      star.style.animationDuration = (durationMin + Math.random() * (durationMax - durationMin)) + "s, " + driftDuration + "s";
      star.style.animationDelay = (Math.random() * durationMax * -1) + "s";
      frag.appendChild(star);
    }
    layer.appendChild(frag);
  }

  makeStars("stars", 80, "far", 1, 1, .2, .5, 3, 6, 60);
  makeStars("stars2", 40, "mid", 1.5, 2, .35, .8, 2, 4, 90);
  makeStars("stars3", 15, "near", 2, 3, .55, 1, 1.5, 3, 120);

  // Scroll reveal observer
  const revealItems = document.querySelectorAll(".reveal");
  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
        obs.unobserve(entry.target);
      }
    });
  }, {threshold:.12});
  revealItems.forEach(el => observer.observe(el));
});
</script>
